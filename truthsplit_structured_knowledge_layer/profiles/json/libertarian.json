  "core_values": [
    {"name": "negative_liberty", "weight": 0.92, "desc": "freedom from coercion"},
    {"name": "property_rights", "weight": 0.88, "desc": "ownership as control over legitimately acquired holdings"},
    {"name": "voluntary_exchange", "weight": 0.85, "desc": "consent as the moral basis of transfer"},
    {"name": "rule_of_law", "weight": 0.70, "desc": "general, predictable, neutral rules"}
  ],
  "key_definitions": [
    {"term": "coercion", "definition": "use or threat of force against person or property"},
    {"term": "rights", "definition": "primarily negative claims against interference; side-constraints"},
    {"term": "property", "definition": "control over justly acquired holdings (acquisition, transfer, rectification)"},
    {"term": "consent", "definition": "voluntary, informed agreement; absence of coercion"},
    {"term": "taxation", "definition": "compulsory state-imposed transfer of property"},
    {"term": "theft", "definition": "taking another's property without consent"},
    {"term": "public_good", "definition": "non-excludable, non-rival good; limited set may justify narrow state provision"},
    {"term": "externality", "definition": "harm imposed on non-consenting others; warrants targeted remedies"},
    {"term": "paternalism", "definition": "coercion justified by claiming to benefit the competent adult coerced"}
  ],
  "assumed_principles": [
    {"name": "self_ownership", "priority": 0.92, "desc": "individuals own their bodies and labor"},
    {"name": "non_aggression_principle", "priority": 0.9, "desc": "initiation of force is impermissible"},
    {"name": "just_acquisition_transfer_rectification", "priority": 0.82, "desc": "Lockean-style holdings legitimacy rules"},
    {"name": "minimal_state_legitimacy", "priority": 0.75, "desc": "state justified only to protect rights"},
    {"name": "contractualism_voluntariness", "priority": 0.78, "desc": "obligations arise chiefly from consent"}
  ],
  "warrants": [
    {"name": "market_efficiency", "confidence": 0.78, "desc": "prices coordinate dispersed knowledge"},
    {"name": "knowledge_problem_of_planning", "confidence": 0.74, "desc": "central planners lack local knowledge"},
    {"name": "government_failure_risk", "confidence": 0.72, "desc": "rent-seeking, capture, bureaucracy"},
    {"name": "rights_as_side_constraints", "confidence": 0.76, "desc": "outcomes cannot override rights"}
  ],
